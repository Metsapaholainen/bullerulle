FMP_API_KEY=your_financial_modeling_prep_api_key_here
NTFY_TOPIC=your_private_ntfy_sh_topic_name_here
# Optional: a separate ntfy.sh topic just for BullaRullaEP alerts, so they
# don't mix into whatever else is subscribed to NTFY_TOPIC. Falls back to
# NTFY_TOPIC if unset.
NTFY_TOPIC_EP=your_private_ntfy_sh_topic_name_here
# Fine-grained GitHub PAT, scoped to just this repo with Contents: read/write --
# only needed so Paper Trading / Sell Alerts / Watchlist data (and
# BullaRullaEP's candidate handoff + alert log) persists across restarts
# (see the "Persistent data" section in DEPLOY.md). Safe to leave unset
# locally -- everything falls back to plain local files without it.
GITHUB_TOKEN=your_fine_grained_github_pat_here
# Powers bullarullaep/catalyst_classifier.py (the LLM news-catalyst
# classifier). Optional -- degrades gracefully (no bonus, no crash) if
# unset; get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
